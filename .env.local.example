# Copie este arquivo para ".env.local" e preencha com os dados do SEU projeto Supabase
# (Configurações > API, dentro do painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui

# Usado apenas para gerar o link do feed de calendário (.ics)
NEXT_PUBLIC_SITE_URL=https://www.luansevero.com.br

# Chave de serviço do Supabase (Configurações > API > "service_role" — NUNCA exponha essa, é só para o servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Google Cloud Console > Credenciais > seu OAuth Client
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google/callback
